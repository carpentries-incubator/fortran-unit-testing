module test_temp_conversions_parameterised
    use temp_conversions, only : fahrenheit_to_celsius, celsius_to_kelvin
    ! allow(C121)
    use funit
    implicit none

    public

    @testParameter
    type, extends(AbstractTestParameter) :: temp_conversions_test_params
        !> The input temperature value
        real :: input
        !> The value we expect to be returned
        real :: expected_output
        !> A description of the test to be outputted for logging
        character(len=100) :: description
    contains
        procedure :: toString => temp_conversions_test_params_toString
    end type temp_conversions_test_params

    !> Type to define a single check_for_steady_state test case
    @TestCase(constructor=paramsToCase)
    type, extends(ParameterizedTestCase) :: temp_conversions_test_case
        type(temp_conversions_test_params) :: params
    end type temp_conversions_test_case

contains
    !*************************************************************************!
    !                      Test fahrenheit_to_celsius                         !
    !-------------------------------------------------------------------------!
    !> Test suite fahrenheit_to_celsius
    function get_fahrenheit_to_celsius_test_suite() result(params)
        !> The array of test parameters
        type(temp_conversions_test_params), allocatable :: params(:)
        params = [ &
            temp_conversions_test_params(0.0, -17.777779, "0.0°F to °C"), &
            temp_conversions_test_params(32.0, 0.0, "°F to 0.0°C"), &
            temp_conversions_test_params(-100.0, -73.333336, "-ve °F to -ve °C"), &
            temp_conversions_test_params(1.23, -17.094444, "+ve °F to -ve °C") &
        ]
    end function get_fahrenheit_to_celsius_test_suite

    !> Test Logic, unit test subroutines for fahrenheit_to_celsius
    @Test(testParameters={get_fahrenheit_to_celsius_test_suite()})
    subroutine test_fahrenheit_to_celsius(this)
        !> The current test case including inputs and expected outputs
        class(temp_conversions_test_case), intent(inout) :: this

        real :: actual_output
        character(len=200) :: failure_message

        ! Get the actual celsius value returned from fahrenheit_to_celsius
        actual_output = fahrenheit_to_celsius(this%params%input)

        ! Populate the failure message
        write(failure_message, '(A,F7.2,A,F7.2,A,F7.2,A)') "Failed With ", this%params%input, " °F: Expected ", &
                this%params%expected_output, "°C but got ", actual_output, "°C"

        ! Assert output
        @assertEqual(this%params%expected_output, actual_output, tolerance=1e-6, message=trim(failure_message))
    end subroutine test_fahrenheit_to_celsius

    !*************************************************************************!


    !*************************************************************************!
    !                         Test celsius_to_kelvin                          !
    !-------------------------------------------------------------------------!
    !> Test suite celsius_to_kelvin
    function get_celsius_to_kelvin_test_suite() result(params)
        !> The array of test parameters
        type(temp_conversions_test_params), allocatable :: params(:)
        params = [ &
            temp_conversions_test_params(0.0, 273.15, "0.0°C to °K"), &
            temp_conversions_test_params(-273.15, 0.0, "Absolute zero °K to °C"), &
            temp_conversions_test_params(-173.15, 100.0, "From -ve °K to +ve °C") &
        ]
    end function get_celsius_to_kelvin_test_suite

    !> Test Logic, unit test subroutine for celsius_to_kelvin
    @Test(testParameters={get_celsius_to_kelvin_test_suite()})
    subroutine test_celsius_to_kelvin(this)
        !> The current test case including inputs and expected outputs
        class(temp_conversions_test_case), intent(inout) :: this

        real :: actual_output
        character(len=200) :: failure_message

        ! Get the actual kelvin value returned from celsius_to_kelvin
        actual_output = celsius_to_kelvin(this%params%input)

        ! Populate the failure message
        write(failure_message, '(A,F7.2,A,F7.2,A,F7.2,A)') "Failed With ", this%params%input, "°C: Expected ", &
                this%params%expected_output, "°K but got ", actual_output, "°K"

        ! Assert output
        @assertEqual(this%params%expected_output, actual_output, tolerance=1e-6, message=trim(failure_message))
    end subroutine test_celsius_to_kelvin

    !*************************************************************************!

    !*************************************************************************!
    !                              Constructors                               !
    !-------------------------------------------------------------------------!

    !> Constructor for temp_conversions_test_case
    function paramsToCase(testParameter) result(tst)
        !> The test parameters for the new test case
        type(temp_conversions_test_params), intent(in) :: testParameter
        !> The new test case
        type(temp_conversions_test_case) :: tst
        tst%params = testParameter
    end function paramsToCase

    !> Converts temp_conversions_test_params to a string for logging
    function temp_conversions_test_params_toString(this) result(string)
        !> The test parameters to convert
        class (temp_conversions_test_params), intent(in) :: this
        !> The resulting string representation
        character(:), allocatable :: string
        string = trim(this%description)
    end function temp_conversions_test_params_toString

    !*************************************************************************!

end module test_temp_conversions_parameterised
