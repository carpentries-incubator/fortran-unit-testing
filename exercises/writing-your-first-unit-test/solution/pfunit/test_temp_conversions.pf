module test_temp_conversions
    use temp_conversions, only : fahrenheit_to_celsius, celsius_to_kelvin
    ! allow(C121)
    use funit
    implicit none

    public

contains

    !*************************************************************************!
    !                      Test fahrenheit_to_celsius                         !
    !-------------------------------------------------------------------------!
    !> Test Logic, unit test subroutines for fahrenheit_to_celsius
    @Test
    subroutine test_fahrenheit_to_celsius()
        call verify_fahrenheit_to_celsius(0.0, -17.777779)
        call verify_fahrenheit_to_celsius(32.0, 0.0)
        call verify_fahrenheit_to_celsius(-100.0, -73.333336)
        call verify_fahrenheit_to_celsius(1.23, -17.094444)
    end subroutine test_fahrenheit_to_celsius

    subroutine verify_fahrenheit_to_celsius(input, expected_output)
        !> The input fahrenheit value to pass to fahrenheit_to_celsius
        real, intent(in) :: input
        !> The celsius value we expect to be returner from fahrenheit_to_celsius
        real, intent(in) :: expected_output

        real :: actual_output
        character(len=200) :: failure_message

        ! Get the actual celsius value returned from fahrenheit_to_celsius
        actual_output = fahrenheit_to_celsius(input)

        ! Populate the failure message
        write(failure_message, '(A,F7.2,A,F7.2,A,F7.2,A)') "Failed With ", input, " °F: Expected ", &
                expected_output, "°C but got ", actual_output, "°C"

        ! Assert output
        @assertEqual(expected_output, actual_output, tolerance=1e-6, message=trim(failure_message))
    end subroutine verify_fahrenheit_to_celsius

    !*************************************************************************!


    !*************************************************************************!
    !                         Test celsius_to_kelvin                          !
    !-------------------------------------------------------------------------!
    !> Test Logic, unit test subroutine for celsius_to_kelvin
    @Test
    subroutine test_celsius_to_kelvin()
        call verify_celsius_to_kelvin(0.0, 273.15)
        call verify_celsius_to_kelvin(-273.15, 0.0)
        call verify_celsius_to_kelvin(-173.15, 100.0)
    end subroutine test_celsius_to_kelvin

    subroutine verify_celsius_to_kelvin(input, expected_output)
        !> The input celsius value to pass to celsius_to_kelvin
        real, intent(in) :: input
        !> The kelvin value we expect to be returner from celsius_to_kelvin
        real, intent(in) :: expected_output

        real :: actual_output
        character(len=200) :: failure_message

        ! Get the actual kelvin value returned from celsius_to_kelvin
        actual_output = celsius_to_kelvin(input)

        ! Populate the failure message
        write(failure_message, '(A,F7.2,A,F7.2,A,F7.2,A)') "Failed With ", input, "°C: Expected ", &
                expected_output, "°K but got ", actual_output, "°K"

        ! Assert output
        @assertEqual(expected_output, actual_output, tolerance=1e-6, message=trim(failure_message))
    end subroutine verify_celsius_to_kelvin

    !*************************************************************************!

end module test_temp_conversions
