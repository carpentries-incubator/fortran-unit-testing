
module test_sum_preceding_rank_values
    use mpi_utils, only : sum_preceding_rank_values
    use pfunit
    implicit none (type, external)
    
    @TestParameter
    type, extends(MPITestParameter) :: sum_preceding_rank_values_params
        integer, allocatable :: expected(:)
        character(100) :: message
    contains
        procedure :: tostring
    end type sum_preceding_rank_values_params

    @TestCase(constructor=sum_preceding_rank_values_constructor)
    type, extends(MPITestCase) :: sum_preceding_rank_values_test_case
        type(sum_preceding_rank_values_params) :: params
    end type sum_preceding_rank_values_test_case

 contains
    
    function tostring(this) result(string)
        class(sum_preceding_rank_values_params), intent(in) :: this
        character(:), allocatable :: string
        string = trim(this%message)
    end function tostring

    function sum_preceding_rank_values_constructor(params) result(test_case)
        class(sum_preceding_rank_values_params), intent(in) :: params
        type(sum_preceding_rank_values_test_case) :: test_case
        test_case%params = params
    end function sum_preceding_rank_values_constructor

    function sum_preceding_rank_values_test_suite() result(test_suite)
        type(sum_preceding_rank_values_params), allocatable :: test_suite(:)
        test_suite = [ &
            sum_preceding_rank_values_params(1, [0], "1 rank"), &
            sum_preceding_rank_values_params(2, [0, 1], "2 rank"), &
            sum_preceding_rank_values_params(4, [0, 1, 3, 6], "4 rank") &
        ]
    end function sum_preceding_rank_values_test_suite

    @test(TestParameters={sum_preceding_rank_values_test_suite()})
    subroutine test_sum_preceding_rank_values_mpi(this)
        class(sum_preceding_rank_values_test_case), intent(inout) :: this
        integer :: actual
        integer :: rank
        actual = sum_preceding_rank_values(this%getMPICommunicator())
        rank = this%getProcessRank()
        @assertEqual(this%params%expected(rank + 1), actual)
    end subroutine test_sum_preceding_rank_values_mpi

end module test_sum_preceding_rank_values